;\n  gap: 1.5rem;\n}\n.faq-item h3 {\n  font-size: 0.95rem;\n  color: #0b1d33;\n  margin-bottom: 0.35rem;\n  font-weight: 600;\n}\n.faq-item p {\n  font-size: 0.875rem;\n  color: #52637a;\n  line-height: 1.5;\n}\n\nfooter {\n  padding: 4rem 8vw;\n  background-color: #0b1d33;\n  color: #8fa0b5;\n  font-size: 0.85rem;\n}\n.footer-inner {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 2rem;\n  max-width: 1040px;\n}\n.footer-brand {\n  font-size: 1.1rem;\n  font-weight: 700;\n  color: #ffffff;\n  margin-bottom: 0.5rem;\n}\n.footer-text {\n  max-width: 320px;\n  line-height: 1.5;\n}\n.footer-links {\n  display: flex;\n  gap: 1.5rem;\n}\n.footer-links a:hover {\n  color: #ffffff;\n}\n\n@media (max-width: 768px) {\n  header.hero-section {\n    padding: 3rem 1.5rem;\n  }\n  section {\n    padding: 3.5rem 1.5rem;\n  }\n  .plan-step.step-1,\n  .plan-step.step-2,\n  .plan-step.step-3 {\n    margin-left: 0;\n    max-width: 100%;\n  }\n  .faq-groups {\n    grid-template-columns: 1fr;\n  }\n}\n</style><header class=\"hero-section\">\n  <div class=\"hero-column\">\n    <span class=\"hero-badge\">节点管理与网络分发</span>\n    <h1>WgetCloud 专线连接服务架构</h1>\n    <p class=\"hero-desc\">通道独立。配置简明。按量调度。为跨区域业务与团队协作提供清晰、受控的网络接入体验。</p>\n    <div class=\"hero-nav\">\n      <a href=\"#plans\" class=\"accent\">配置方案</a>\n      <a href=\"#setup\">接入步骤</a>\n      <a href=\"#clients\">软件支持</a>\n      <a href=\"#faq\" class=\"outline\">常见问答</a>\n    </div>\n  </div>\n</header>\n\n<main>\n  <section id=\"plans\">\n    <div class=\"section-head\">\n      <span class=\"section-tag\">Tiered Structure</span>\n      <h2>阶梯式服务套餐</h2>\n      <p>资源额度层层递增。按并发设备数与流量需求自主选型。</p>\n    </div>\n\n    <div class=\"plans-stepped\">\n      <div class=\"plan-step step-1\">\n        <div class=\"plan-header\">\n          <div class=\"plan-title-area\">\n            <h3 class=\"plan-name\">基础版</h3>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥15/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">开通基础版</a>\n      </div>\n\n      <div class=\"plan-step step-2\">\n        <div class=\"plan-header\">\n          <div class=\"plan-title-area\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"tag-badge\">主力推荐</span>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥35/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">开通旗舰版</a>\n      </div>\n\n      <div class=\"plan-step step-3\">\n        <div class=\"plan-header\">\n          <div class=\"plan-title-area\">\n            <h3 class=\"plan-name\">团队版</h3>\n            <span class=\"tag-badge\">高并发</span>\n          </div>\n          <div class=\"plan-price-group\">\n            <span class=\"plan-price\">¥85/月</span>\n            <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n          </div>\n        </div>\n        <ul class=\"feature-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"plan-action\">开通团队版</a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"setup\">\n    <div class=\"section-head\">\n      <span class=\"section-tag\">Quick Deployment</span>\n      <h2>接入与配置流程</h2>\n      <p>三个清晰动作。无需冗杂调试，即刻上线。</p>\n    </div>\n\n    <div class=\"guide-grid\">\n      <div class=\"guide-card\">\n        <span class=\"guide-step-no\">STEP 01</span>\n        <h3>获取订阅凭证</h3>\n        <p>购买所需计划。进入用户仪表盘复制对应的通用订阅链接，妥善保管密钥。</p>\n      </div>\n\n      <div class=\"guide-card\">\n        <span class=\"guide-step-no\">STEP 02</span>\n        <h3>导入管理工具</h3>\n        <p>在对应的受支持客户端中，粘贴订阅 URL，执行节点列表同步并拉取配置。</p>\n      </div>\n\n      <div class=\"guide-card\">\n        <span class=\"guide-step-no\">STEP 03</span>\n        <h3>按规则分流</h3>\n        <p>选择分流模式或目标地域。确认系统代理状态生效，连接即可建立。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"section-head\">\n      <span class=\"section-tag\">Cross Platform</span>\n      <h2>终端适配</h2>\n      <p>覆盖主流作业系统，配合标准化协议客户端无缝协作。</p>\n    </div>\n\n    <div class=\"clients-grid\">\n      <div class=\"client-card\">\n        <h3>Windows 平台</h3>\n        <p>支持原生 Clash Verge 及常用内核工具。系统托盘常驻，资源占用低。</p>\n        <span class=\"client-meta\">支持 Windows 10 / 11 架构</span>\n      </div>\n\n      <div class=\"client-card\">\n        <h3>macOS 系统</h3>\n        <p>针对 Apple Silicon 原生优化。提供规则拆分与系统代理一键托管。</p>\n        <span class=\"client-meta\">适配 macOS 12 Monterey 及更新</span>\n      </div>\n\n      <div class=\"client-card\">\n        <h3>iOS / iPadOS</h3>\n        <p>搭配 Shadowrocket 或 Stash。支持快捷指令、按需启动与配置热更新。</p>\n        <span class=\"client-meta\">iOS 14.0 或更高版本</span>\n      </div>\n\n      <div class=\"client-card\">\n        <h3>Android 设备</h3>\n        <p>适配 Clash Meta for Android 等应用。省电分流，切网无感知保持连接。</p>\n        <span class=\"client-meta\">支持 Android 8.0 及以上系统</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"section-head\">\n      <span class=\"section-tag\">Troubleshooting &amp; Policies</span>\n      <h2>常见问答</h2>\n      <p>按照账户、网络与服务细则归类。按需查阅。</p>\n    </div>\n\n    <div class=\"faq-groups\">\n      <div class=\"faq-group\">\n        <div class=\"faq-group-title\">账户与计费策略</div>\n        <div class=\"faq-list\">\n          <article class=\"faq-item\">\n            <h3>流量到期后如何结算？</h3>\n            <p>每月重置日按方案固定配额刷新。用量耗尽后自动暂停转发，次周期自动恢复。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>如何升级或调整当前订阅？</h3>\n            <p>在后台直接选定新方案，系统自动折算剩余天数差价，支付后即刻提升设备配额。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>同时在线设备数如何界定？</h3>\n            <p>以实际发起活动连接的物理终端数量为准。短时间内超出限制将触发风控断流。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <div class=\"faq-group-title\">网络与技术支持</div>\n        <div class=\"faq-list\">\n          <article class=\"faq-item\">\n            <h3>专线节点与常规节点有何区别？</h3>\n            <p>专线节点采用专用内网跳板通道，抖动较低；常规节点池适合常规网页访问与轻量下载。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>节点不可用时如何排查？</h3>\n            <p>首先核对本地时间同步状态，再尝试更新订阅链接。如持续异常可提交工单排查出口状态。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>工单响应时效是多久？</h3>\n            <p>旗舰版与团队版提供优先队列排查，工作时段平均半小时内确认，全周无间断轮值。</p>\n          </article>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <div class=\"footer-inner\">\n    <div>\n      <div class=\"footer-brand\">WgetCloud</div>\n      <p class=\"footer-text\">结构清晰的节点转发与网络中继体系。专注高效链路与稳定连接。</p>\n    </div>\n    <div class=\"footer-links\">\n      <a href=\"#plans\">方案列表</a>\n      <a href=\"#setup\">配置指引</a>\n      <a href=\"#clients\">平台兼容</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</footer>",
